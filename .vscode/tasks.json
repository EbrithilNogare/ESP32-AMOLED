{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "env",
      "type": "pickString",
      "description": "PlatformIO environment",
      "default": "amoled",
      "options": ["amoled", "amoled-debug"]
    }
  ],
  "tasks": [
    {
      "label": "ESP: build",
      "type": "shell",
      "command": "pio run -e ${input:env}",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "ESP: build & upload & monitor",
      "type": "shell",
      "command": "pio run -e ${input:env} -t upload -t monitor",
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "ESP: upload",
      "type": "shell",
      "command": "pio run -e ${input:env} -t upload",
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "ESP: upload OTA (Wi-Fi)",
      "detail": "Open System → Wireless update on the device first; set ESP_OTA_PASSWORD in your shell.",
      "type": "shell",
      "command": "pio run -e amoled-ota -t upload",
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "ESP: monitor",
      "type": "shell",
      "command": "pio device monitor -e ${input:env}",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "ESP: upload filesystem (data/)",
      "type": "shell",
      "command": "pio run -e ${input:env} -t uploadfs",
      "problemMatcher": []
    },
    {
      "label": "ESP: clean",
      "type": "shell",
      "command": "pio run -e ${input:env} -t clean",
      "problemMatcher": []
    },
    {
      "label": "ESP: erase flash",
      "type": "shell",
      "command": "pio run -e ${input:env} -t erase",
      "problemMatcher": []
    },
    {
      "label": "Test: unit tests (PC)",
      "type": "shell",
      "command": "pio test -e native",
      "group": "test",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Test: UI simulator + screenshots (PC)",
      "type": "shell",
      "command": "pio run -e sim && .pio/build/sim/program && python tools/sim/shots.py",
      "group": "test",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Assets: regenerate fonts/images",
      "type": "shell",
      "command": "python tools/assets.py",
      "problemMatcher": []
    }
  ]
}
